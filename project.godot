; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="deckbuilder-cultivation"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Ambiance="*res://ui/theme/ambiance.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="deckbuilder-cultivation"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="uid://cqoir5fnb7fno"

[internationalization]

locale/translations=PackedStringArray("res://localization/textes.fr.translation", "res://localization/textes.en.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05882353, 0.08627451, 0.1254902, 1)

[shader_globals]

motion_scale={
"type": "float",
"value": 1.0
}

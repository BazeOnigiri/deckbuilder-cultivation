; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="deckbuilder-cultivation"
config/version="1.1.0"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Ambiance="*res://ui/theme/ambiance.tscn"
Sons="*res://ui/audio/sound_bank.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="deckbuilder-cultivation"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

timers/tooltip_delay_sec=0.15
theme/custom="uid://cqoir5fnb7fno"


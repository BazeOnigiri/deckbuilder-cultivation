renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05882353, 0.08627451, 0.1254902, 1)

[shader_globals]

motion_scale={
"type": "float",
"value": 1.0
}
pulse_color={
